{
  "datasets": [
    {
      "name": "55296f7e",
      "displayName": "host_hourly",
      "queryLines": [
        "SELECT hour_ts, cpu_busy_avg * 100 AS cpu_busy_pct, cpu_busy_p95 * 100 AS cpu_p95_pct,\n",
        "       mem_used_pct, load1_avg, temp_avg_c, temp_max_c, minutes_over_70c,\n",
        "       net_rx_bytes_s / 1024 AS net_rx_kib_s, net_tx_bytes_s / 1024 AS net_tx_kib_s\n",
        "FROM homelab.gold.host_hourly"
      ],
      "catalog": "homelab",
      "schema": "default"
    },
    {
      "name": "cf833eb3",
      "displayName": "container_daily",
      "queryLines": [
        "SELECT dt, container, cpu_cores_avg, cpu_cores_p95, mem_mib_avg, mem_mib_max\n",
        "FROM homelab.gold.container_daily"
      ],
      "catalog": "homelab",
      "schema": "default"
    },
    {
      "name": "6a92aa26",
      "displayName": "freshness",
      "queryLines": [
        "SELECT max(ts) AS latest_sample,\n",
        "       datediff(current_timestamp(), max(ts)) AS days_old,\n",
        "       count(DISTINCT dt) AS days_covered\n",
        "FROM homelab.silver.prom_samples"
      ]
    },
    {
      "name": "host_latest",
      "displayName": "host_latest",
      "queryLines": [
        "SELECT\n",
        "  hour_ts,\n",
        "  cpu_busy_avg * 100 AS cpu_busy_pct,\n",
        "  mem_used_pct,\n",
        "  temp_avg_c\n",
        "FROM\n",
        "  homelab.gold.host_hourly\n",
        "ORDER BY\n",
        "  hour_ts DESC\n",
        "LIMIT 1"
      ]
    }
  ],
