# Copy to ~/hl-orch/.env (chmod 600). Never commit the real file.
HUB_URL=http://localhost:3010
PVE_HOST=<proxmox-lan-ip>
PVE_NODE=<proxmox-node-name>
PVE_MAC=<proxmox-wol-mac>
LXC_HOST=<etl-lxc-lan-ip>
LXC_ID=130
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=<personal-access-token>
STALE_DAYS=10
SHUTDOWN_HOST=1
BACKUP_START=04:25
BACKUP_END=05:15
DRY_RUN=1
